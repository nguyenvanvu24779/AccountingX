{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AccountingX",
  "version": "../package.json",
  "identifier": "vn.accountingx.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AccountingX",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 360,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 12,
          "y": 22
        },
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri://localhost localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: tauri://*; style-src 'self' 'unsafe-inline' https: http:; img-src 'self' asset: https://asset.localhost blob: data: https: http:; font-src 'self' data: https: http: tauri://*; connect-src 'self' ipc: https://ipc.localhost http://ipc.localhost http://localhost:* https: http: ws: wss:; frame-src 'self' data: about: http://localhost:* http://127.0.0.1:* https://*;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$RESOURCE/**",
          "$HOME/.cache/**/*",
          "$HOME/.codex/.tmp/**/*",
          "$HOME/.codex/plugins/**/*",
          "$HOME/.codex/skills/**/*",
          "$HOME/.codex/skills/.system/**/*",
          "$HOME/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "accountingx"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": false,
    "resources": {
      "resources/codex/*": "resources/codex/",
      "../bots/zalo/": "resources/bots/zalo/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "AccountingX"
}
